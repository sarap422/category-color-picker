msgid "Category Color"
msgstr "カテゴリーカラー"

msgid "Category Color Settings"
msgstr "カテゴリーカラー設定"

msgid "Select the color to use for this category."
msgstr "このカテゴリーに使用する色を選択してください。"

msgid "Configure selectors for category colors"
msgstr "カテゴリーカラーを反映するセレクタを設定する"

msgid "Settings saved."
msgstr "設定を保存しました。"

msgid "CSS Selectors for Category Colors"
msgstr "カテゴリーカラーを反映するCSSセレクタ"

msgid "Set CSS selectors to apply category colors."
msgstr "カテゴリーカラーを適用するCSSセレクタを設定してください。"

msgid "The {$slug} part will be replaced with the category slug."
msgstr "{$slug} の部分がカテゴリースラッグに置き換えられます。"

msgid "Separate multiple selectors with commas."
msgstr "複数のセレクタはカンマで区切って指定してください。"

msgid "Usage Example"
msgstr "使用例"

msgid "CSS example generated with current settings:"
msgstr "現在の設定で生成されるCSS例："

msgid "Common Selectors"
msgstr "よく使われるセレクタ"

msgid "For VK All in One Expansion Unit:"
msgstr "VK All in One Expansion Unit用："

msgid "For Post Type & Taxonomy Filter:"
msgstr "Post Type & Taxonomy Filter用："

msgid "General category links:"
msgstr "一般的なカテゴリーリンク："

msgid "Category List"
msgstr "カテゴリー一覧"

msgid "Go to Category Management"
msgstr "カテゴリー管理画面へ"

msgid "Color"
msgstr "色"

msgid "Not set"
msgstr "未設定"

msgid "You do not have sufficient permissions to access this page."
msgstr "このページにアクセスする権限がありません。"

msgid "Security check failed."
msgstr "セキュリティチェックに失敗しました。"

# --- 1.2.0: Export / Import ---

msgid "Export"
msgstr "エクスポート"

msgid "Import"
msgstr "インポート"

msgid "This will overwrite the color and noindex settings of existing categories with matching slugs. Continue?"
msgstr "同じスラッグの既存カテゴリーの色・Noindex 設定を上書きします。続けますか？"

msgid "Please select a JSON file."
msgstr "JSON ファイルを選択してください。"

msgid "Failed to parse JSON."
msgstr "JSON の解析に失敗しました。"

msgid "Invalid file format (no categories)."
msgstr "ファイル形式が不正です（categories がありません）。"

msgid "created"
msgstr "件作成"

msgid "updated"
msgstr "件更新"

msgid "errors"
msgstr "件エラー"

msgid "An error occurred: "
msgstr "エラーが発生しました："

msgid "You do not have permission."
msgstr "権限がありません。"

msgid "The data is invalid."
msgstr "データが無効です。"

msgid "Required plugin files are missing: %s. Please reinstall the plugin."
msgstr "必要なプラグインファイルが見つかりません：%s。プラグインを再インストールしてください。"

# --- 1.3.1: Text Color Luminance Threshold ---

msgid "Text Color Luminance Threshold"
msgstr "テキストカラーの輝度閾値"

msgid "Background colors with a luminance above this value use dark text; below it, white text is used. Range: 0.00–1.00 (default: 0.60)."
msgstr "この値より輝度が高い背景色には暗いテキスト、低い背景色には白いテキストが使われます。範囲：0.00〜1.00（初期値：0.60）。"